# One file for everything: docker-compose.yml passes this .env to the API, worker, web and Caddy.
# Copy to .env, fill in the real values, and never commit .env.

# ==========================================
# 1. Domains & Reverse Proxy (Caddyfile)
# ==========================================
WEB_DOMAIN=agrivive.example.com
API_DOMAIN=api.agrivive.example.com
# Public. Used at web build time. Never put a secret here.
NEXT_PUBLIC_API_URL=https://api.agrivive.example.com
# Public Google reCAPTCHA v3 site key. The secret key goes only in backend/.env.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ==========================================
# 2. Database & Core App
# ==========================================
APP_ENV=production
DATABASE_URL=postgresql://user:password@aws-postgres-host:5432/agrivive
BETTER_AUTH_SECRET=replace-with-production-secret
BETTER_AUTH_URL=https://api.agrivive.example.com
WEB_APP_URL=https://agrivive.example.com
WEB_TRUSTED_ORIGINS=https://agrivive.example.com
MOBILE_TRUSTED_ORIGINS=agrivive://
ORDER_QR_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STAKEHOLDER_EMAILS=

# ==========================================
# 3. Visibility Policy & Algorithm
# ==========================================
# AHP-TOPSIS is the default. Set visibility-v4 to roll back to the baseline formula.
VISIBILITY_POLICY=visibility-ahptopsis-v1

# ==========================================
# 4. Email
# ==========================================
# If EMAIL_PROVIDER is empty, production uses resend and development uses mailtrap.
EMAIL_PROVIDER=mailtrap
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Agrivive <verify@example.com>
ALLOW_DEV_EMAIL_LOG=false

# ==========================================
# 5. Push Notifications (Firebase)
# ==========================================
PUSH_NOTIFICATIONS_ENABLED=false
PUSH_MESSAGE_WINDOW_SECONDS=60
PUSH_MAX_ATTEMPTS=4
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ==========================================
# 6. Trust Actions
# ==========================================
# Code default is on when this is unset. The thresholds below are the code defaults.
TRUST_ACTIONS_ENABLED=false
TRUST_WARNING_THRESHOLD=4
TRUST_RESTRICTION_THRESHOLD=6
TRUST_BLOCK_THRESHOLD=10

# ==========================================
# 7. n8n Automation & Social Boost
# ==========================================
N8N_VISIBILITY_BOOST_WEBHOOK_URL=
N8N_VISIBILITY_BOOST_SERVICE_TOKEN=
GROQ_API_KEY=
GROQ_PROMOTION_MODEL=openai/gpt-oss-20b
SOCIAL_PUBLIC_API_URL=
META_GRAPH_API_VERSION=
SOCIAL_FACEBOOK_PAGE_ID=
SOCIAL_META_PAGE_ACCESS_TOKEN=
SOCIAL_INSTAGRAM_USER_ID=

# ==========================================
# 8. File Storage (AWS S3)
# ==========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=
ADVISORY_HTTP_PROXY=
