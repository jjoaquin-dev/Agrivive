DATABASE_URL=postgresql://user:password@localhost:5432/agrivive
BETTER_AUTH_SECRET=replace-with-a-long-random-server-secret
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Expo development origins, e.g. exp://192.168.1.20:8081.
# The production agrivive:// app scheme is trusted by default.
MOBILE_TRUSTED_ORIGINS=
WEB_TRUSTED_ORIGINS=http://localhost:3001
WEB_APP_URL=http://localhost:3001
STAKEHOLDER_EMAILS=
ORDER_QR_SECRET=replace-with-at-least-32-random-characters
MAILTRAP_API_TOKEN=replace-with-mailtrap-api-token
MAILTRAP_INBOX_ID=replace-with-mailtrap-inbox-id
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=Agrivive <verify@example.com>
EMAIL_PROVIDER=mailtrap
ALLOW_DEV_EMAIL_LOG=false

# Trust actions are prototype policy settings, not research-proven thresholds.
# Keep disabled until the team completes manual validation and policy approval.
TRUST_ACTIONS_ENABLED=false
TRUST_WARNING_THRESHOLD=3
TRUST_RESTRICTION_THRESHOLD=5
TRUST_BLOCK_THRESHOLD=8
TRUST_RESTRICTION_HOURS=168

# Push notifications are optional in local development. Keep service credentials server-side.
PUSH_NOTIFICATIONS_ENABLED=false
PUSH_MESSAGE_WINDOW_SECONDS=60
PUSH_MAX_ATTEMPTS=4
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Visibility ranking policy. Keep visibility-v4 until the AHP-TOPSIS pilot is approved.
VISIBILITY_POLICY=visibility-v4

# Seller-controlled Priority Boost share drafts; credentials remain server-side.
N8N_PROMOTION_WEBHOOK_URL=https://n8n.example.com/webhook/agrivive-priority-promotion
N8N_PROMOTION_SERVICE_TOKEN=replace-with-a-long-random-shared-service-token

# Seller Boost Visibility. Keep every credential in the backend environment only.
SOCIAL_PUBLIC_API_URL=https://api.example.com
N8N_SOCIAL_PUBLISH_WEBHOOK_URL=https://n8n.example.com/webhook/agrivive-social-publish
N8N_SOCIAL_SERVICE_TOKEN=replace-with-a-separate-long-random-token
N8N_VISIBILITY_BOOST_WEBHOOK_URL=https://n8n.example.com/webhook/agrivive-visibility-boost
N8N_VISIBILITY_BOOST_SERVICE_TOKEN=replace-with-a-separate-visibility-boost-token
GROQ_API_KEY=replace-with-groq-api-key
GROQ_PROMOTION_MODEL=openai/gpt-oss-20b
META_GRAPH_API_VERSION=vXX.X
SOCIAL_FACEBOOK_PAGE_ID=replace-with-agrivive-facebook-page-id
SOCIAL_META_PAGE_ACCESS_TOKEN=replace-with-page-access-token
SOCIAL_INSTAGRAM_USER_ID=replace-with-linked-instagram-professional-account-id
SOCIAL_X_API_KEY=replace-with-x-api-key
SOCIAL_X_API_SECRET=replace-with-x-api-secret
SOCIAL_X_ACCESS_TOKEN=replace-with-x-user-access-token
SOCIAL_X_ACCESS_TOKEN_SECRET=replace-with-x-user-access-token-secret

# AWS S3 Storage for Profile Pictures and Product Media
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=replace-with-agrivive-s3-bucket
ADVISORY_HTTP_PROXY=
