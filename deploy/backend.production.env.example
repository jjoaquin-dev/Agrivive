APP_ENV=production

# Use the AWS PostgreSQL database for the production container.
DATABASE_URL=postgresql://user:password@aws-postgres-host:5432/agrivive

BETTER_AUTH_SECRET=replace-with-production-secret
BETTER_AUTH_URL=https://api.agrivive.example.com
WEB_APP_URL=https://agrivive.example.com
WEB_TRUSTED_ORIGINS=https://agrivive.example.com
MOBILE_TRUSTED_ORIGINS=agrivive://

PUSH_NOTIFICATIONS_ENABLED=false
PUSH_MESSAGE_WINDOW_SECONDS=60
PUSH_MAX_ATTEMPTS=4
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

STAKEHOLDER_EMAILS=
ORDER_QR_SECRET=replace-with-production-secret

MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Agrivive <verify@example.com>
EMAIL_PROVIDER=mailtrap
ALLOW_DEV_EMAIL_LOG=false

TRUST_ACTIONS_ENABLED=false
TRUST_WARNING_THRESHOLD=3
TRUST_RESTRICTION_THRESHOLD=5
TRUST_BLOCK_THRESHOLD=8
TRUST_RESTRICTION_HOURS=168

VISIBILITY_POLICY=visibility-v4

SOCIAL_PUBLIC_API_URL=
N8N_VISIBILITY_BOOST_WEBHOOK_URL=
N8N_VISIBILITY_BOOST_SERVICE_TOKEN=
GROQ_API_KEY=
GROQ_PROMOTION_MODEL=openai/gpt-oss-20b
META_GRAPH_API_VERSION=
SOCIAL_FACEBOOK_PAGE_ID=
SOCIAL_META_PAGE_ACCESS_TOKEN=
SOCIAL_INSTAGRAM_USER_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=
ADVISORY_HTTP_PROXY=
