EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional Android OAuth client for a future native Google sign-in flow.
# This value is public; never place a client secret in the mobile app.
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# For a physical phone, use the computer's LAN address, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
# Android Emulator can use http://10.0.2.2:3000.

# Public web address (legal pages) and public Google reCAPTCHA v3 site key. No secrets here.
EXPO_PUBLIC_WEB_URL=https://agrivive.tech
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=
