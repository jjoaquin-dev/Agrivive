{
  "expo": {
    "name": "Agrivive",
    "slug": "mobile",
    "scheme": "agrivive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/agrivive-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/agrivive-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agrivive.seller",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.agrivive.seller",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/agrivive-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/agrivive-splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-build-properties",
      "expo-location",
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "72ecbc0b-cd45-4e5d-adfa-bae9545a5900"
      }
    },
    "owner": "j.joaquin.dev"
  }
}
