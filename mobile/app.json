{
  "expo": {
    "name": "Agrivive",
    "slug": "mobile",
    "scheme": "agrivive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/agrivive-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agrivive.seller",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.agrivive.seller",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/agrivive-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/agrivive-splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-location",
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e64477e-cda0-4d9b-8f02-174adda7da11"
      }
    },
    "owner": "joaquin_jara"
  }
}
