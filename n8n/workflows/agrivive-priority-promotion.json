    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const event = $('Promotion Webhook').first().json.body ?? $('Promotion Webhook').first().json;\nconst response = $input.first().json;\nconst raw = response.choices?.[0]?.message?.content;\ntry {\n  const draft = JSON.parse(raw);\n  const headline = typeof draft.headline === 'string' ? draft.headline.trim() : '';\n  const caption = typeof draft.caption === 'string' ? draft.caption.trim() : '';\n  if (!headline || headline.length > 80 || !caption || caption.length > 280) throw new Error('Invalid draft fields');\n  return [{ json: { jobId: event.jobId, headline, caption } }];\n} catch {\n  return [{ json: { jobId: event.jobId, errorCode: 'invalid_draft' } }];\n}"
      },
