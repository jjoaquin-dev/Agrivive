{
  "name": "Agrivive Boost - Confirmed Facebook Post",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agrivive-visibility-boost",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "11111111-0001-4000-8000-000000000001",
      "name": "1. Boost Confirmed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://YOUR_AGRIVIVE_API_HOST/integrations/visibility-boosts/{{$json.body.boostId}}/context",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "id": "11111111-0002-4000-8000-000000000002",
      "name": "2. Get Boost Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'openai/gpt-oss-20b', temperature: 0.4, response_format: { type: 'json_object' }, messages: [{ role: 'system', content: 'You are Agrivive social media copywriter. Return a JSON object with a single caption field. Write a short, friendly Facebook post. If reason is initial, announce the fresh produce. If reason is price_reduction, announce the price drop with the old and new price. Use only the facts given. Do not change any number. Do not write any link; the system adds the product link.' }, { role: 'user', content: JSON.stringify({ reason: $json.reason, product: $json.product.name, unit: $json.product.unit, price_php: $json.product.price, previous_price_php: $json.previousPrice, shop: $json.seller.shopName }) } ] } }}"
      },
      "id": "11111111-0003-4000-8000-000000000003",
      "name": "3. Write Caption (Groq)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('2. Get Boost Context').first().json;\nconst price = Number(ctx.product.price).toFixed(2);\nlet caption = ctx.reason === 'initial'\n  ? `Fresh ${ctx.product.name} is now available at ₱${price} from ${ctx.seller.shopName}!`\n  : `Price drop! ${ctx.product.name} is now ₱${price} at ${ctx.seller.shopName}. Get yours before it sells out!`;\ntry {\n  const parsed = JSON.parse($input.first().json.choices[0].message.content);\n  if (typeof parsed.caption === 'string' && parsed.caption.trim()) caption = parsed.caption.trim();\n} catch (e) {}\nreturn [{ json: { boostId: ctx.boostId, caption } }];"
      },
      "id": "11111111-0004-4000-8000-000000000004",
      "name": "4. Format Caption",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://YOUR_AGRIVIVE_API_HOST/integrations/visibility-boosts/{{$json.boostId}}/facebook-post",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "caption",
              "value": "={{$json.caption}}"
            }
          ]
        }
      },
      "id": "11111111-0005-4000-8000-000000000005",
      "name": "5. Post to Facebook Through Agrivive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        300
      ]
    }
  ],
  "connections": {
    "1. Boost Confirmed": {
