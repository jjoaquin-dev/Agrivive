        "jsCode": "const reduced = $('8. Ask API to Reduce Price by Seller Percent').first().json;\nconst ctx = $('7. Get Latest Boost Context').first().json;\nlet caption = `Price drop! ${reduced.productName} is now ₱${reduced.newPrice} (was ₱${reduced.originalPrice}) at ${ctx.seller.shopName}. Get yours before it sells out!`;\ntry {\n  const parsed = JSON.parse($input.first().json.choices[0].message.content);\n  if (typeof parsed.caption === 'string' && parsed.caption.trim()) caption = parsed.caption.trim();\n} catch (e) {}\nreturn [{ json: { boostId: ctx.boostId, caption } }];"
      },
